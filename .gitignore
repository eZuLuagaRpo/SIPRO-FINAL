# ============================================
# Seguridad y Certificados
# ============================================

# Certificados privados (IMPORTANTE: revisar antes de commitear)
*.pem
*.pfx
*.key
*.p12
!**/certificates/README.md

# Keystores sensibles
*.jks
*.keystore
!**/test-data/**/*.jks

# Variables de entorno
.env
.env.local
.env.*.local

# ============================================
# Datos y Archivos Temporales
# ============================================

# Excel/CSV de prueba
*.xlsx
*.xls
*.csv
!**/test-data/**/*.xlsx
!**/test-data/**/*.csv

# Backups
*.bak
*.swp
*.swo

# ============================================
# Infraestructura (opcional)
# ============================================

# Terraform (si se usa)
*.tfstate
*.tfstate.backup
.terraform/

# Docker (si se versiona compose local)
docker-compose.override.yml

# ============================================
# SIPRO - Archivos locales no versionables
# ============================================

# Archivos de diseño Photoshop
*.psd

# Workspace de VS Code local
*.code-workspace

# Carpeta Markdown (docs internas de contexto de agentes)
# Se ignora todo el contenido EXCEPTO README.md
Markdown/*
!Markdown/README.md

# Archivos temporales de Claude / agentes
tmpclaude-*

# Keystores de produccion (Impala truststore)
# Se versionan SOLO los de test-data
backend/services/validation-service/src/main/resources/certificates/*.jks
backend/services/validation-service/bin/main/certificates/*.jks
